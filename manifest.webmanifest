{
  "name": "Family Chore Schedule",
  "short_name": "Chores",
  "description": "Chore and allowance tracker for Isabel, Nuno and Zion.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/chore-board/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#1e4bc0",
  "theme_color": "#173a95",
  "categories": ["productivity", "lifestyle"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icons/icon-192.png",  "sizes": "192x192",   "type": "image/png" },
    { "src": "icons/icon-512.png",  "sizes": "512x512",   "type": "image/png" },
    { "src": "icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Today's chores",
      "short_name": "Chores",
      "url": "./index.html?tab=chores",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "This week",
      "short_name": "Chart",
      "url": "./index.html?tab=chart",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Balances",
      "short_name": "Balances",
      "url": "./index.html?tab=money",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
